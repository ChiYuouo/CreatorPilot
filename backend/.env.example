# CreatorPilot 后端环境变量
# 将此模板复制到 backend/.env，设置随机 SECRET_KEY 并填写 LLM_API_KEY。
# 这是应用唯一的环境配置文件；Compose 也通过 --env-file 读取它。

# PostgreSQL 数据库（Docker Compose 将本机 5433 端口映射到容器 5432 端口）
DATABASE_URL=postgresql+asyncpg://creatorpilot:creatorpilot@localhost:5433/creatorpilot

# Redis 缓存（Docker Compose 将本机 6380 端口映射到容器 6379 端口）
REDIS_URL=redis://localhost:6380/0

# Celery 消息代理地址；留空时复用 REDIS_URL
CELERY_BROKER_URL=

# 素材保存目录与预览链接有效期；素材目录会在首次上传时自动创建。
MEDIA_ROOT=.local/media
MEDIA_PREVIEW_EXPIRE_SECONDS=900
# 相对于 backend/ 解析（发布进程始终从该目录启动），不使用特定机器的绝对路径。
PUBLISHER_PYTHON=.venv-publish/Scripts/python.exe

# 单次平台上传的等待上限（秒）；超时后停止本机发布进程
PUBLISH_TIMEOUT_SECONDS=300

# 平台数据只读采集
METRICS_SYNC_TIMEOUT_SECONDS=180
METRICS_SYNC_MAX_PAGES=10

# JWT 签名密钥，生产环境必须更换
SECRET_KEY=dev-secret-change-me-to-a-random-32-byte-key

# 令牌有效期
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 允许跨域访问的来源列表，多个来源用逗号分隔
CORS_ORIGINS=http://localhost:5173

# 大语言模型（兼容 OpenAI 协议，默认使用 DeepSeek）
# 在 https://platform.deepseek.com 获取密钥
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=120

# 智能体会话限制
AGENT_MAX_TOOL_ROUNDS=5
AGENT_HISTORY_LIMIT=20
AGENT_SESSION_TTL_SECONDS=604800
